# Node.js server port
PORT=5000

# ESP32 USB Serial configuration
SERIAL_PORT=COM17
SERIAL_BAUD_RATE=115200

# IP Webcam MJPEG stream URLs for North and South cameras
# Example: http://192.168.1.101:8080/video
CAM_NORTH_URL=http://10.245.55.176:8080/video
CAM_SOUTH_URL=http://192.168.1.102:8080/video



# Emergency signal priority distance thresholds (meters)
PRIORITY_PREPARE_DISTANCE_M=500
PRIORITY_ACTIVATE_DISTANCE_M=300

# Auto-cancel emergency mode if no GPS update received within this time (ms)
EMERGENCY_TIMEOUT_MS=120000
